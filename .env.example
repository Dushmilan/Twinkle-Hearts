# ===========================================
# Twinkle-Hearts Environment Configuration
# ===========================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# -------------------------------------------
# Application
# -------------------------------------------
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3001

# -------------------------------------------
# Google OAuth (Required for Google Sign-In)
# -------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# -------------------------------------------
# Database (PostgreSQL)
# -------------------------------------------
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/twinkle_hearts_dev

# -------------------------------------------
# Redis (Optional - for caching/sessions)
# -------------------------------------------
# REDIS_URL=redis://localhost:6379
# REDIS_ENABLED=false

# -------------------------------------------
# Authentication (JWT)
# -------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your-refresh-token-secret-change-in-production
REFRESH_TOKEN_EXPIRES_IN=30d

# -------------------------------------------
# WhatsApp Business API (Optional for MVP)
# -------------------------------------------
# Get these from Meta Business Manager
WHATSAPP_BUSINESS_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_NUMBER=919876543210

# -------------------------------------------
# Tax Configuration
# -------------------------------------------
TAX_RATE=0.18

# -------------------------------------------
# Admin Seed Credentials (used by prisma/seed-admin.ts)
ADMIN_EMAIL=admin@twinklehearts.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Admin
ADMIN_PHONE=+9412345678

# Test User Credentials (used by prisma/seed-admin.ts)
TEST_USER_EMAIL=testuser@twinklehearts.com
TEST_USER_PASSWORD=TestUser123!

# Rate Limiting
# -------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
ORDER_RATE_LIMIT_MAX=5

# -------------------------------------------
# CORS
# -------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# -------------------------------------------
# Docker Services (for docker-compose.yml)
# -------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-postgres-password
POSTGRES_DB=twinkle_hearts_dev
REDIS_COMMANDER_USER=admin
REDIS_COMMANDER_PASSWORD=your-secure-redis-password
PGADMIN_EMAIL=admin@twinklehearts.local
PGADMIN_PASSWORD=your-secure-pgadmin-password

# -------------------------------------------
# Logging
# -------------------------------------------
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# -------------------------------------------
# Email (Optional - for notifications)
# -------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# -------------------------------------------
# File Upload (Optional)
# -------------------------------------------
# MAX_FILE_SIZE=5242880
# UPLOAD_DIR=./uploads

# -------------------------------------------
# Monitoring (Optional)
# -------------------------------------------
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
