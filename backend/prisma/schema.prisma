// This is your Prisma schema file
// Private Commercial Project - Confidential

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER ROLE ENUM
// ============================================
enum UserRole {
  CUSTOMER
  ADMIN
  VENDOR
}

// ============================================
// ORDER STATUS ENUM
// ============================================
enum OrderStatus {
  PENDING_WHATSAPP_CONFIRMATION
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED
}

// ============================================
// ADDRESS TYPE ENUM
// ============================================
enum AddressType {
  HOME
  WORK
  BILLING
  SHIPPING
  OTHER
}

// ============================================
// USER MODEL
// ============================================
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String?   // Null for OAuth users
  name          String?
  phone         String?
  avatar        String?   // Profile picture URL
  role          UserRole  @default(CUSTOMER)
  emailVerified Boolean   @default(false)
  isActive      Boolean   @default(true)
  
  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  
  // Relations
  addresses     Address[]
  orders        Order[]
  wishlist      Wishlist[]
  sessions      Session[]
  adminLogs     AdminLog[]
  
  // Indexes
  @@index([email])
  @@index([role])
  @@index([isActive])
}

// ============================================
// SESSION MODEL (JWT Token Tracking)
// ============================================
model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String   @unique  // Hash of JWT token
  refreshToken String?  @unique
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  
  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

// ============================================
// ADDRESS MODEL
// ============================================
model Address {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String      // "Home", "Work", etc.
  type       AddressType @default(HOME)
  street     String
  city       String
  state      String
  zip        String
  country    String      @default("LK")
  phone      String
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  
  @@index([userId])
  @@index([isDefault])
}

// ============================================
// WISHLIST MODEL
// ============================================
model Wishlist {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade, name: "ProductWishlist")
  createdAt  DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

// ============================================
// PRODUCT MODEL
// ============================================
model Product {
  id          String   @id @default(uuid())
  name        String
  description String
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  sku         String   @unique
  category    String?
  images      String[] @default([])
  isFeatured  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems  OrderItem[]
  wishlistBy  Wishlist[] @relation("ProductWishlist")

  @@index([name])
  @@index([category])
  @@index([isFeatured])
  @@index([isActive])
}

// ============================================
// ORDER MODEL
// ============================================
model Order {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  
  customerName    String
  customerPhone   String
  
  status          OrderStatus @default(PENDING_WHATSAPP_CONFIRMATION)
  
  subtotal        Decimal     @db.Decimal(10, 2)
  tax             Decimal     @db.Decimal(10, 2)
  total           Decimal     @db.Decimal(10, 2)
  
  // Store prices at time of order (for audit)
  priceSnapshot   Json        @default("[]")
  
  // WhatsApp integration
  whatsappMessageId String?
  whatsappStatus    String?
  
  // Timestamps
  createdAt     DateTime  @default(now())
  expiresAt     DateTime?
  confirmedAt   DateTime?
  updatedAt     DateTime  @updatedAt
  
  items         OrderItem[]
  
  @@index([userId])
  @@index([status])
  @@index([customerPhone])
  @@index([createdAt])
  @@index([expiresAt])
}

// ============================================
// ORDER ITEM MODEL
// ============================================
model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Product snapshot (denormalized for historical accuracy)
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName String  // Store name in case product changes
  quantity    Int
  price       Decimal @db.Decimal(10, 2)

  @@unique([orderId, productId])
  @@index([orderId])
  @@index([productId])
}

// ============================================
// ADMIN LOG MODEL (Audit Trail)
// ============================================
model AdminLog {
  id         String   @id @default(uuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  action     String   // "CREATE_PRODUCT", "UPDATE_ORDER", etc.
  entity     String?  // "Product", "Order", etc.
  entityId   String?
  details    Json?    // Additional context
  ip         String?
  createdAt  DateTime @default(now())
  
  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}
