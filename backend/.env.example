# Backend Environment Variables
# Copy to .env.local and fill in your values

# Application
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/twinkle_hearts_dev

# Redis (Optional)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# WhatsApp
WHATSAPP_BUSINESS_NUMBER=919876543210
WHATSAPP_BUSINESS_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
ORDER_RATE_LIMIT_MAX=5

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# Admin Seed Credentials (used by prisma/seed-admin.ts)
ADMIN_EMAIL=admin@twinklehearts.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Admin
ADMIN_PHONE=+9412345678

# Test User Credentials (used by prisma/seed-admin.ts)
TEST_USER_EMAIL=testuser@twinklehearts.com
TEST_USER_PASSWORD=TestUser123!

# Cloudinary (Optional - for backend-side image operations)
# Note: Frontend uploads directly to Cloudinary using unsigned uploads
# These credentials are only needed for server-side operations (e.g., deleting images)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
