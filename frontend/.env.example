# Frontend Environment Variables
# Copy to .env.local and fill in your values

# API Configuration
# In production: set to empty to use same-origin (/api/* routed via _worker.js)
# In dev: Vite proxy in vite.config.ts forwards /api/* to localhost:8787
VITE_API_URL=

# Note: Cloudinary configuration is now handled by the backend
# Images are uploaded via the backend API using signed uploads
# Configure Cloudinary credentials in backend/.env.local
