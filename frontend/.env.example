# Frontend Environment Variables
# Copy to .env.local and fill in your values

# API Configuration
VITE_API_URL=http://localhost:3001

# Cloudinary Configuration (for image uploads)
# Get these from your Cloudinary dashboard: https://cloudinary.com/console
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=twinkle-hearts-products

# Note: Create an unsigned upload preset in Cloudinary dashboard:
# 1. Go to Settings > Upload
# 2. Add upload preset named "twinkle-hearts-products"
# 3. Set "Signing Mode" to "Unsigned"
# 4. Set folder to "twinkle-hearts/products"
